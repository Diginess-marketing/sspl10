VITE_SITE_URL=https://ssplt10.co.in
VITE_API_URL=https://ssplt10.co.in
VITE_YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE
VITE_YOUTUBE_CHANNEL_ID=UC_CHANNEL_ID_HERE

# Set to false if the database has no cms_items table yet (pages use built-in content)
VITE_CMS_ENABLED=true

# Set to false if the database has no player-photos bucket yet (photo upload is skipped)
VITE_PLAYER_PHOTO_UPLOAD_ENABLED=true

# Two-step sign-in: every admin must set up an authenticator app (pair with REQUIRE_ADMIN_MFA on the backend)
# VITE_REQUIRE_ADMIN_MFA=true
