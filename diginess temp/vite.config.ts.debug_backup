import { defineConfig, Plugin } from 'vite';
import react from '@vitejs/plugin-react-swc';
import path from 'path';
import viteCompression from 'vite-plugin-compression';
import { visualizer } from 'rollup-plugin-visualizer';

// --- HTML Performance / Injection Plugin (sanitized version) ---
function performanceOptimizationPlugin(): Plugin {
  return {
    name: 'performance-optimization',
    enforce: 'post',
    transformIndexHtml: {
      order: 'post',
      handler(html: string) {
        // Console suppression script (inject as first script in head)
        if (!html.includes('disable-console.js')) {
          const consoleScript = '\n  <!-- Console Suppression -->\n  <script src="/disable-console.js"></script>';
          html = html.replace('<head>', `<head>${consoleScript}`);
        }

        // Resource hints (inject once)
        if (!html.includes('<!-- Critical Resource Hints for Performance -->')) {
          const resourceHints = '\n  <!-- Critical Resource Hints for Performance -->\n  <link rel="preconnect" href="https://www.googletagmanager.com">\n  <link rel="dns-prefetch" href="https://www.googletagmanager.com">\n  <link rel="preconnect" href="https://checkout.razorpay.com">\n  <link rel="dns-prefetch" href="https://checkout.razorpay.com">\n  <link rel="preconnect" href="https://fonts.googleapis.com">\n  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>';
          html = html.replace('</head>', `${resourceHints}</head>`);
        }

        // Remove global smtp.js (prefer lazy load)
        html = html.replace(/\n\s*<script src="https:\/\/smtpjs.com\/v3\/smtp.js" defer><\/script>\s*/, '\n');

        // JSON-LD (Organization + SportsEvent)
        if (!html.includes('application/ld+json') && html.includes('</head>')) {
          const jsonLd = {
            '@context': 'https://schema.org',
            '@graph': [
              {
                '@type': 'Organization',
                name: 'SSPL T10',
                url: 'https://ssplt10.com/',
                logo: 'https://ssplt10.com/ssplt10-logo.png',
                sameAs: ['https://twitter.com/ssplt10'],
                description: "India's premier T10 cricket league with nationwide trials and prize pool.",
                contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', email: 'support@ssplt10.com' },
              },
              {
                '@type': 'SportsEvent',
                name: 'SSPL T10 National Trials',
                sport: 'Cricket',
                eventStatus: 'https://schema.org/EventScheduled',
                organizer: { '@type': 'Organization', name: 'SSPL T10' },
                location: { '@type': 'Place', address: { '@type': 'PostalAddress', addressCountry: 'IN' } },
              },
            ],
          };
          html = html.replace('</head>', `\n<script type="application/ld+json">${JSON.stringify(jsonLd)}</script>\n</head>`);
        }

        // Razorpay defer safeguard
        html = html.replace(/<script src="https:\/\/checkout\.razorpay\.com\/v1\/checkout\.js"><\/script>/g, '<script defer src="https://checkout.razorpay.com/v1/checkout.js"></script>');

        // Localhost SW guard (disable registration script)
        const swGuard = '\n<script>(function(){try{var h=location.hostname;if(h===\'localhost\'||h===\'127.0.0.1\'){var s=document.getElementById(\'vite-plugin-pwa:register-sw\');if(s&&s.parentNode){s.parentNode.removeChild(s);}}}catch(e){}})();</script>';
        if (!html.includes('Disabled register script for localhost preview')) {
          html = html.replace('</head>', `${swGuard}\n</head>`);
        }

        // Optional SW unregister (?sw=off)
        const swUnregister = '\n<script>(function(){try{var h=location.hostname;if(h===\'localhost\'||h===\'127.0.0.1\'){var qs=new URLSearchParams(location.search);if(qs.get(\'sw\')===\'off\'){if(\'serviceWorker\' in navigator && navigator.serviceWorker.getRegistrations){navigator.serviceWorker.getRegistrations().then(function(regs){regs.forEach(function(r){r.unregister();});});}if(window.caches&&window.caches.keys){caches.keys().then(function(keys){keys.forEach(function(k){caches.delete(k);});});}}}}catch(e){}})();</script>';
        if (!html.includes('Unregistered all and cleared caches (sw=off)')) {
          html = html.replace('</head>', `${swUnregister}\n</head>`);
        }

        // Sanitize srcset values (decode then replace whitespace)
        try {
          html = html.replace(/(imagesrcset|srcset)="([^"]+)"/g, (_: string, attr: string, val: string) => {
            try {
              const items = val.split(',').map((raw: string) => {
                const seg = raw.trim();
                const lastSpace = seg.lastIndexOf(' ');
                if (lastSpace === -1) {
                  return decodeURIComponent(seg).replace(/\s+/g, '-');
                }
                const urlPart = seg.slice(0, lastSpace);
                const desc = seg.slice(lastSpace + 1);
                return `${decodeURIComponent(urlPart).replace(/\s+/g, '-')} ${desc}`;
              });
              return `${attr}="${items.join(', ')}"`;
            } catch { return _; }
          });
        } catch { /* no-op */ }

        return html;
      },
    },
  };
}

// --- Cache Headers Plugin ---
function cacheHeadersPlugin(): Plugin {
  return {
    name: 'cache-headers',
    enforce: 'post',
    closeBundle() {
      // _headers file is already created in public folder
      // This ensures it's copied to dist
      // console.log('✓ Cache headers configured via public/_headers');
    }
  };
}

// --- Plugins ---
const plugins = [
  react() as any,
  performanceOptimizationPlugin(),
  cacheHeadersPlugin(),
  viteCompression({ algorithm: 'brotliCompress', ext: '.br', threshold: 10240, deleteOriginFile: false }),
  viteCompression({ algorithm: 'gzip', ext: '.gz', threshold: 10240, deleteOriginFile: false }),
];

if (process.env.NODE_ENV === 'analyze') {
  plugins.push(visualizer({ open: true, filename: 'dist/stats.html' }));
}

// Preview debug flag for conditional minification
// Always remove console in production builds, unless explicitly in dev mode
const isDevMode = process.env.NODE_ENV === 'development';
const dynamicTerser = {
  compress: {
    drop_console: true, // Always drop console statements
    drop_debugger: true, // Always drop debugger statements
    pure_funcs: ['console.log', 'console.info', 'console.debug', 'console.warn', 'console.error', 'console.trace'],
    passes: 3,  // Multiple passes for better optimization
    dead_code: true,
    keep_infinity: true,
    arrows: true,
    collapse_vars: true,
    reduce_vars: true,
    unused: true,
    inline: 3,
    // Additional aggressive optimizations
    booleans_as_integers: false, // Keep booleans as booleans for compatibility
    evaluate: true,
    join_vars: true,
    loops: true,
    negate_iife: true,
    properties: true,
    sequences: true,
    side_effects: true,
    switches: true,
    typeofs: true,
    conditionals: true,
    comparisons: true,
    hoist_funs: true,
    hoist_props: true,
    if_return: true,
    reduce_funcs: true,
  },
  format: {
    comments: false,
    beautify: false,
    ascii_only: false,
  },
  mangle: {
    safari10: true,
    toplevel: false,
  },
};

export default defineConfig(() => ({
  base: '/',
  resolve: { alias: { '@': path.resolve(__dirname, 'src') } },
  define: {
    __VITE_BASE_DIR__: JSON.stringify(__dirname),
    __VITE_SRC_DIR__: JSON.stringify(path.resolve(__dirname, 'src')),
  },
  envDir: __dirname,
  envPrefix: 'VITE_',
  server: {
    port: 5173,
    strictPort: false,
    host: true, // Listen on all network interfaces
    hmr: true,
    // SPA fallback - serve index.html for all routes
    proxy: {},
    middlewareMode: false,
  },
  preview: {
    port: parseInt(process.env.VITE_PREVIEW_PORT || '4173'),
    strictPort: false,
    host: 'localhost',
    proxy: {},
    cors: true,
    // Avoid aggressive immutable caching in preview to prevent stale HTML referencing old chunk names.
    // Use short-term caching for assets; HTML will naturally be revalidated.
    headers: {
      'Cache-Control': 'public, max-age=60',
      'X-Content-Type-Options': 'nosniff',
      'X-Frame-Options': 'DENY',
      'X-XSS-Protection': '1; mode=block',
    },
  },
  plugins,
  build: {
    outDir: 'dist',
    chunkSizeWarningLimit: 1500,
    rollupOptions: {
      external: ['razorpay'], // Node.js only library, should not be bundled
      onwarn(warning, defaultHandler) {
        if (warning.code === 'MODULE_LEVEL_DIRECTIVE') return; // silence "use client" noise
        if (warning.code === 'UNUSED_EXTERNAL_IMPORT') return; // silence unused external imports
        defaultHandler(warning);
      },
      output: {
        // Let Rollup handle chunking automatically to avoid module initialization order issues
        entryFileNames: 'assets/[name]-[hash].js',
        chunkFileNames: 'assets/[name]-[hash].js',
        assetFileNames(assetInfo) {
          const originalName = assetInfo.name || '';
          const decoded = decodeURIComponent(originalName);
          const safeName = decoded.replace(/\s+/g, '-');
          if (/\.(png|jpe?g|svg|gif|tiff|bmp|ico|webp|avif)$/i.test(decoded)) return `assets/images/${safeName}-[hash][extname]`;
          if (/\.(css)$/i.test(decoded)) return `assets/css/${safeName}-[hash][extname]`;
          if (/\.(woff|woff2|ttf|eot)$/i.test(decoded)) return `assets/fonts/${safeName}-[hash][extname]`;
          return `assets/${safeName}-[hash][extname]`;
        },
      },
    },
    cssCodeSplit: true,
    cssMinify: 'esbuild',
    sourcemap: false,
    minify: 'terser',
    terserOptions: dynamicTerser,
    modulePreload: true,
    assetsInlineLimit: 2048,
    reportCompressedSize: true,
    target: 'es2020',
    commonjsOptions: {
      include: [/node_modules/],
      transformMixedEsModules: true,
      requireReturnsDefault: 'auto',
      esmExternals: true
    },
  },
  optimizeDeps: {
    include: ['react', 'react/jsx-runtime', 'react-dom', 'react-dom/client', 'react-router-dom', 'scheduler', '@tanstack/react-query', 'clsx', 'tailwind-merge'],
    esbuildOptions: { target: 'es2020' },
  },
  esbuild: { logOverride: { 'this-is-undefined-in-esm': 'silent' }, legalComments: 'none', treeShaking: true },
}));
