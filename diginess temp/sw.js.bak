// Advanced Service Worker with Enhanced Caching Strategies
// Version: 2.0.0
// Generated by VitePWA with custom enhancements

importScripts('https://storage.googleapis.com/workbox-cdn/releases/6.5.4/workbox-sw.js');

// Enable debug logging in development
workbox.setConfig({
  debug: false, // Set to true for development debugging
});

// Cache versioning for better control
const CACHE_VERSION = 'v2.0.0';
const CACHE_NAMES = {
  static: `ssplt10-static-${CACHE_VERSION}`,
  dynamic: `ssplt10-dynamic-${CACHE_VERSION}`,
  images: `ssplt10-images-${CACHE_VERSION}`,
  api: `ssplt10-api-${CACHE_VERSION}`,
  fonts: `ssplt10-fonts-${CACHE_VERSION}`,
};

// Precache essential resources
workbox.precaching.precacheAndRoute(self.__WB_MANIFEST || []);

// Clean up old caches on activation
self.addEventListener('activate', (event) => {
  event.waitUntil(
    caches.keys().then((cacheNames) => {
      return Promise.all(
        cacheNames.map((cacheName) => {
          // Delete old caches that don't match current version
          if (!Object.values(CACHE_NAMES).includes(cacheName)) {
            console.log('[SW] Deleting old cache:', cacheName);
            return caches.delete(cacheName);
          }
        })
      );
    })
  );
  // Take control of all clients immediately
  self.clients.claim();
});

// Enhanced caching strategies

// 1. Cache-first strategy for static assets (JS, CSS, HTML)
workbox.routing.registerRoute(
  ({ request }) => {
    const { destination } = request;
    return destination === 'script' ||
           destination === 'style' ||
           (destination === 'document' && request.url.includes('/'));
  },
  new workbox.strategies.CacheFirst({
    cacheName: CACHE_NAMES.static,
    plugins: [
      new workbox.expiration.ExpirationPlugin({
        maxEntries: 100,
        maxAgeSeconds: 60 * 60 * 24 * 30, // 30 days
        purgeOnQuotaError: true,
      }),
      new workbox.cacheableResponse.CacheableResponsePlugin({
        statuses: [0, 200],
      }),
    ],
  })
);

// 2. Network-first strategy for API calls (with cache fallback)
workbox.routing.registerRoute(
  ({ url }) => url.pathname.startsWith('/api/'),
  new workbox.strategies.NetworkFirst({
    cacheName: CACHE_NAMES.api,
    networkTimeoutSeconds: 3,
    plugins: [
      new workbox.expiration.ExpirationPlugin({
        maxEntries: 50,
        maxAgeSeconds: 60 * 5, // 5 minutes for API data
        purgeOnQuotaError: true,
      }),
      new workbox.cacheableResponse.CacheableResponsePlugin({
        statuses: [0, 200],
      }),
    ],
  })
);

// 3. Stale-while-revalidate for images (fast loading with background updates)
workbox.routing.registerRoute(
  ({ request }) => request.destination === 'image',
  new workbox.strategies.StaleWhileRevalidate({
    cacheName: CACHE_NAMES.images,
    plugins: [
      new workbox.expiration.ExpirationPlugin({
        maxEntries: 200,
        maxAgeSeconds: 60 * 60 * 24 * 60, // 60 days for images
        purgeOnQuotaError: true,
      }),
      new workbox.cacheableResponse.CacheableResponsePlugin({
        statuses: [0, 200],
      }),
      // Add background sync for failed image requests
      new workbox.backgroundSync.BackgroundSyncPlugin('image-queue', {
        maxRetentionTime: 24 * 60, // 24 hours
      }),
    ],
  })
);

// 4. Cache-first for fonts with long expiration
workbox.routing.registerRoute(
  ({ url }) => url.origin === 'https://fonts.googleapis.com' ||
               url.origin === 'https://fonts.gstatic.com',
  new workbox.strategies.CacheFirst({
    cacheName: CACHE_NAMES.fonts,
    plugins: [
      new workbox.expiration.ExpirationPlugin({
        maxEntries: 30,
        maxAgeSeconds: 60 * 60 * 24 * 365, // 1 year for fonts
        purgeOnQuotaError: true,
      }),
      new workbox.cacheableResponse.CacheableResponsePlugin({
        statuses: [0, 200],
      }),
    ],
  })
);

// 5. Runtime caching for dynamic content (external resources)
workbox.routing.registerRoute(
  ({ url }) => url.origin !== location.origin &&
               !url.origin.includes('fonts.googleapis.com') &&
               !url.origin.includes('fonts.gstatic.com'),
  new workbox.strategies.StaleWhileRevalidate({
    cacheName: CACHE_NAMES.dynamic,
    plugins: [
      new workbox.expiration.ExpirationPlugin({
        maxEntries: 100,
        maxAgeSeconds: 60 * 60 * 24 * 7, // 7 days for external resources
        purgeOnQuotaError: true,
      }),
      new workbox.cacheableResponse.CacheableResponsePlugin({
        statuses: [0, 200],
      }),
    ],
  })
);

// Handle push notifications
self.addEventListener('push', (event) => {
  if (!event.data) return;

  const data = event.data.json();
  const options = {
    body: data.body,
    icon: '/icon-192x192.png',
    badge: '/icon-192x192.png',
    vibrate: [100, 50, 100],
    data: {
      dateOfArrival: Date.now(),
      primaryKey: data.primaryKey || 1,
    },
    actions: [
      {
        action: 'explore',
        title: 'View Details',
        icon: '/icon-192x192.png',
      },
      {
        action: 'close',
        title: 'Close',
        icon: '/icon-192x192.png',
      },
    ],
  };

  event.waitUntil(
    self.registration.showNotification(data.title || 'SSPL T10 Update', options)
  );
});

// Handle notification clicks
self.addEventListener('notificationclick', (event) => {
  event.notification.close();

  if (event.action === 'explore') {
    event.waitUntil(
      clients.openWindow(event.notification.data.url || '/')
    );
  }
});

// Background sync for offline actions
workbox.routing.registerRoute(
  ({ url }) => url.pathname.includes('/sync/'),
  new workbox.strategies.NetworkOnly({
    plugins: [
      new workbox.backgroundSync.BackgroundSyncPlugin('sync-queue', {
        maxRetentionTime: 24 * 60, // 24 hours
        onSync: async ({ queue }) => {
          console.log('[SW] Background sync triggered');
          // Handle sync operations here
        },
      }),
    ],
  }),
  'POST'
);

// Periodic cache cleanup
self.addEventListener('message', (event) => {
  if (event.data && event.data.type === 'CLEAN_CACHE') {
    event.waitUntil(
      caches.keys().then((cacheNames) => {
        return Promise.all(
          cacheNames.map((cacheName) => {
            return caches.open(cacheName).then((cache) => {
              return cache.keys().then((requests) => {
                return Promise.all(
                  requests.map((request) => {
                    // Remove entries older than 30 days
                    return cache.match(request).then((response) => {
                      if (response) {
                        const date = response.headers.get('date');
                        if (date) {
                          const age = Date.now() - new Date(date).getTime();
                          if (age > 30 * 24 * 60 * 60 * 1000) { // 30 days
                            return cache.delete(request);
                          }
                        }
                      }
                    });
                  })
                );
              });
            });
          })
        );
      }).then(() => {
        console.log('[SW] Cache cleanup completed');
      })
    );
  }
});

// Performance monitoring
self.addEventListener('message', (event) => {
  if (event.data && event.data.type === 'GET_CACHE_STATS') {
    event.waitUntil(
      caches.keys().then(async (cacheNames) => {
        const stats = {};
        for (const cacheName of cacheNames) {
          const cache = await caches.open(cacheName);
          const keys = await cache.keys();
          stats[cacheName] = keys.length;
        }
        event.ports[0].postMessage(stats);
      })
    );
  }
});

console.log('[SW] Advanced Service Worker v2.0.0 loaded successfully');