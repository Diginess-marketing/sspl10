# Production build values (Vercel). Vite uses this file for `vite build`, ahead of .env.local.
# Variables set in the Vercel dashboard still override everything here.
#
# ONLY PUBLIC VALUES. Every VITE_ variable is shipped to visitors' browsers, so the Supabase
# URL and anon key are fine here; the service-role key, Razorpay secret and SMTP passwords
# must never be added (they belong in Render's environment for the backend).

VITE_SUPABASE_URL=https://fazpykekypcktcmniwbj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZhenB5a2VreXBja3RjbW5pd2JqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTU4MjQyMzcsImV4cCI6MjA3MTQwMDIzN30.98XobDzYVd8eyUVpnOLNaCgw0l8AnTIR886Eja-Z_hM
VITE_SITE_URL=https://sspl10.vercel.app

# Render backend, e.g. https://<your-service>.onrender.com (no trailing slash). Set it here or in Vercel.
# VITE_API_URL=

# The live database has no cms_items table or player-photos bucket yet
VITE_CMS_ENABLED=false
VITE_PLAYER_PHOTO_UPLOAD_ENABLED=false

