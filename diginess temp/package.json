{
  "name": "sspl-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "echo Prebuild skipped",
    "build": "vite build && node scripts/copy-optimized-to-dist.mjs && node scripts/copy-svg-assets.mjs && node scripts/async-css.mjs",
    "build:analyze": "vite build --mode analyze",
    "build:production": "cross-env NODE_ENV=production vite build && node scripts/copy-optimized-to-dist.mjs && node scripts/copy-svg-assets.mjs && node scripts/async-css.mjs",
    "build:preview": "vite build",
    "build:dev": "cross-env NODE_ENV=development vite build",
    "build:fast": "cross-env NODE_ENV=production node build-tracker.js \"vite build --mode fast\" && node scripts/copy-optimized-to-dist.mjs && node scripts/copy-svg-assets.mjs && node scripts/async-css.mjs",
    "build:fast:profile": "time npm run build:fast",
    "build:profile": "NODE_ENV=production time node build-tracker.js \"vite build\"",
    "build:benchmark": "for i in {1..3}; do time npm run build:fast; done",
    "build:watch": "vite build --watch",
    "build:incremental": "npm run build:fast",
    "dev": "vite",
    "serve": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "type-check:fast": "tsc --noEmit --skipLibCheck",
    "preview": "node scripts/port-manager.js --start",
    "clean": "rm -rf dist node_modules/.vite node_modules/.cache",
    "clean:all": "rm -rf dist node_modules/.vite node_modules/.cache node_modules",
    "size": "npx vite-bundle-analyzer dist",
    "sitemap": "node scripts/generate-sitemap.js",
    "deps:check": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u",
    "performance:monitor": "npm run build:fast:profile && npm run size",
    "performance:report": "npm run build:analyze && open dist/stats.html",
    "performance:check": "node scripts/performance-check.js",
    "performance:audit": "npm run build:fast && npm run performance:check",
    "android:generate:icons": "node scripts/generate-icons.js",
    "android:init:bubblewrap": "node scripts/init-bubblewrap.js",
    "bubblewrap:init": "npm install -g @bubblewrap/cli && bubblewrap init --manifest=https://yourdomains.com/manifest.json",
    "bubblewrap:build:debug": "cd ../.. && cd android-pwa && ./gradlew assembleDebug",
    "bubblewrap:build:release": "cd ../.. && cd android-pwa && ./gradlew bundleRelease",
    "bubblewrap:create-keystore": "node scripts/create-keystore.js",
    "android:keystore": "bash scripts/create-keystore.sh",
    "android:build:pwa": "npm run build:production && echo 'Web build complete. Ready for Bubblewrap.'",
    "android:debug:apk": "npm run android:build:pwa && npm run bubblewrap:build:debug",
    "android:release:aab": "npm run android:build:pwa && npm run bubblewrap:build:release",
    "postbuild": "echo Build completed successfully",
    "seo:validate": "node ../validate-seo.cjs",
    "seo:validate:dist": "node ../validate-seo.cjs dist/index.html",
    "seo:check": "npm run build && npm run seo:validate:dist",
    "seo:schema-validate": "node validate-schema.js",
    "seo:a11y:check": "npm run build && node scripts/a11y-audit.js dist/index.html",
    "seo:performance:audit": "npm run build && npm run lighthouse",
    "seo:full-audit": "npm run seo:check && npm run seo:schema-validate && npm run seo:a11y:check",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:clean": "node scripts/cleanup-optimized.mjs",
    "images:avif": "node scripts/generate-avif-hero.mjs",
    "html:rewrite": "node scripts/rewrite-html.mjs",
    "optimize:all": "npm run images:optimize && npm run html:rewrite",
    "images:svgo": "svgo -f public -r -q --config .svgo.config.js && svgo -f . -r -q --config .svgo.config.js",
    "images:report": "node scripts/report-image-savings.mjs",
    "images:audit": "node scripts/image-audit.js",
    "ssg:generate": "node scripts/minimal-ssg.js",
    "ssg:build": "npm run build && npm run ssg:generate",
    "ssg:serve": "npm run ssg:generate && npx serve dist-ssg -p 4175",
    "port:check": "node scripts/port-manager.js",
    "port:clean": "node scripts/port-clean.js",
    "port:force-clean": "taskkill /f /im node.exe"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@livekit/components-react": "^2.9.20",
    "@livekit/components-styles": "^1.2.0",
