    "node-domexception": "^1.0.0",
    "lodash.get": "^4.4.2",
    "lodash.isequal": "^4.5.0",
    "inflight": "^1.0.6"
  },
  "vitest": {
    "globals": true,
    "environment": "jsdom",
    "environmentOptions": {
      "jsdom": {
        "resources": "usable"
      }
    },
    "setupFiles": [
      "./src/test/setup.ts"
    ],
    "css": true,
    "include": [
      "src/**/*.{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}"
    ]
  }
}
