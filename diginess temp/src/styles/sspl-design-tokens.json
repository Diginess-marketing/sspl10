{
    "meta": {
        "name": "SSPL Sport Pro Design System",
        "version": "1.0.0",
        "description": "Modern, professional, sporty design tokens for cricket league platforms"
    },
    "colors": {
        "primary": {
            "midnightNavy": "#001b69",
            "stadiumBlue": "#1C2541",
            "electricCyan": "#001b69"
        },
        "secondary": {
            "crimsonStrike": "#CCFF00",
            "pitchGreen": "#CCFF00"
        },
        "neutral": {
            "cloudWhite": "#F8F9FA",
            "steelGray": "#ADB5BD",
            "charcoal": "#343A40"
        },
        "states": {
            "success": "#22c55e",
            "error": "#ef4444",
            "warning": "#F4A261",
            "info": "#001b69",
            "disabled": "#6C757D"
        }
    },
    "typography": {
        "fontFamily": {
            "primary": [
                "Inter",
                "Poppins",
                "system-ui",
                "sans-serif"
            ]
        },
        "scale": {
            "h1": "48-56px",
            "h2": "32-40px",
            "h3": "22-28px",
            "body": "14-16px",
            "micro": "12-13px"
        },
        "weights": {
            "regular": 400,
            "medium": 500,
            "semibold": 600,
            "bold": 700
        },
        "numerics": {
            "tabular": true
        }
    },
    "spacing": {
        "scale": [
            4,
            8,
            12,
            16,
            24,
            32,
            48,
            64
        ],
        "radius": {
            "sm": 8,
            "md": 12,
            "lg": 16,
            "xl": 24
        },
        "shadows": {
            "card": "0 8px 24px rgba(0,0,0,0.15)",
            "hover": "0 12px 32px rgba(0,0,0,0.25)"
        }
    },
    "grid": {
        "desktop": 12,
        "tablet": 8,
        "mobile": 4,
        "gutter": 16
    }
}