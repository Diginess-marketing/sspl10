# Copy to `.env.production` (loaded first) or `.env` (fallback) and fill in.
# Never commit the filled-in files.

NODE_ENV=production
PORT=3003

# --- Supabase ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service role key bypasses RLS; required for the admin endpoints and jobs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signature verification rejects every request without this.
RAZORPAY_WEBHOOK_SECRET=

# --- Microsoft Graph (outbound email) ---
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_FROM_EMAIL=

# --- Sarvam (support chat agent) ---
SARVAM_API_KEY=
# SARVAM_API_URL=https://api.sarvam.ai/v1/chat/completions
# SARVAM_MODEL=sarvam-m

# --- Gemini (admin natural-language query) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- WhatsApp Cloud API (chat webhook stays inert without these) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# Automatic player messages on WhatsApp (optional). Each value is the name of a template
# approved in WhatsApp Manager; a stage without one is sent by email only.
#   trial slot:          {{1}} first name, {{2}} date, {{3}} time, {{4}} venue
#   payment reminders:   {{1}} first name, {{2}} registration link
# WHATSAPP_TEMPLATE_TRIAL_SLOT_ALLOCATED=
# WHATSAPP_TEMPLATE_PAYMENT_REMINDER=
# WHATSAPP_TEMPLATE_PAYMENT_REMINDER_2=
# WHATSAPP_TEMPLATE_LANGUAGE=en
# Signs partner page links (defaults to a server secret if unset)
# PARTNER_LINK_SECRET=
